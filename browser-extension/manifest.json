{
  "manifest_version": 3,
  "name": "Cloud AI Platform Monitor",
  "version": "1.0.0",
  "description": "Quick-glance cloud monitoring, alerts, and AI recommendations for the Cloud Usage Monitoring platform - works alongside the existing web dashboard.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Cloud AI Platform Monitor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "alarms", "notifications", "tabs"],
  "host_permissions": ["http://localhost:8000/*"]
}
